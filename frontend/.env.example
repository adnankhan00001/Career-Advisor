# OneStop Career Advisor - Frontend Environment Configuration
# Copy this file to .env.local for local development or set in your production hosting platform

# Base URL pointing to the Spring Boot REST API
NEXT_PUBLIC_API_URL=http://localhost:8080

# WebRTC STUN / TURN Configuration (Optional in dev, required for production NAT traversal)
NEXT_PUBLIC_WEBRTC_STUN_URL=stun:stun.l.google.com:19302
# NEXT_PUBLIC_WEBRTC_TURN_URL=turn:turn.yourdomain.com:3478
# NEXT_PUBLIC_WEBRTC_TURN_USERNAME=your-turn-user
# NEXT_PUBLIC_WEBRTC_TURN_CREDENTIAL=your-turn-password
