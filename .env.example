# ==============================================================================
# OneStop Career Advisor — Root Environment Template
# ==============================================================================
# Copy the appropriate section to frontend/.env.local or backend environment.
# DO NOT commit real passwords, secrets, or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (frontend/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_WEBRTC_STUN_URL=stun:stun.l.google.com:19302

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (backend/.env or system environment)
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/career_advisor?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_local_mysql_password
# JWT Authentication (HS256 minimum 256-bit cryptographic key - generate via `openssl rand -hex 32`)
JWT_SECRET=your_256_bit_jwt_secret_placeholder_must_be_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_EMAIL=admin@careeradvisor.dev
ADMIN_PASSWORD=your_secure_admin_password_placeholder
ADMIN_NAME=System Administrator
AI_ENABLED=true
AI_PROVIDER=mock
AI_API_KEY=
MENTOR_MIN_MENTEES=1
MENTOR_MAX_MENTEES=10
MENTOR_DEFAULT_MENTEES=3
