# ==============================================================================
# OneStop Career Advisor — Backend Environment Configuration Template
# ==============================================================================
# Copy this template to your environment configuration or deployment platform.
# DO NOT commit real passwords, secrets, or API keys to version control.
# ==============================================================================

# Active Spring Profile (dev for local development, prod for production)
SPRING_PROFILES_ACTIVE=dev

# Server Port
PORT=8080

# Database Connectivity (Standard Spring or separate host/port parameters)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/career_advisor?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_local_mysql_password

# Alternative Individual Database Variables (used by application-dev/prod.properties)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=career_advisor
DB_USERNAME=root
DB_PASSWORD=your_local_mysql_password

# JWT Authentication (HS256 minimum 256-bit cryptographic hex or string key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Initial Bootstrap Administrator (created/verified on startup by AdminDataInitializer)
ADMIN_EMAIL=admin@careeradvisor.dev
ADMIN_PASSWORD=AdminPass123!
ADMIN_NAME=System Administrator

# AI Infrastructure Configuration (provider: mock, gemini, openai)
AI_ENABLED=true
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7
AI_TIMEOUT_SECONDS=30
AI_CHAT_MAX_MESSAGE_LENGTH=4000
AI_CHAT_HISTORY_LIMIT=20
AI_CHAT_TITLE_MAX_LENGTH=80
AI_CHAT_ENABLED=true

# WebRTC Signaling & ICE Configuration (for peer-to-peer audio/video calls)
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
WEBRTC_CALL_TIMEOUT=45

# Mentorship Capacity Defaults
MENTOR_MIN_MENTEES=1
MENTOR_MAX_MENTEES=10
MENTOR_DEFAULT_MENTEES=3

# File Upload Sizing Limits
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=10MB
